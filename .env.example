# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE - APLIKASI BANTUIN
# PERHATIAN: Salin file ini menjadi .env dan isi dengan kredensial rahasia lokal Anda.
# JANGAN PERNAH menyertakan file .env atau kredensial produksi ke dalam version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI APLIKASI & SERVER BACKEND
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. KONEKSI DATABASE MYSQL 8.0
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bantuin_db
DB_USER=root
DB_PASSWORD=your_secure_mysql_password_here
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true
DB_TIMEZONE=+07:00

# ------------------------------------------------------------------------------
# 3. KEAMANAN OTENTIKASI & JWT
# ------------------------------------------------------------------------------
# Gunakan string acak minimal 32 karakter untuk secret key
JWT_ACCESS_SECRET=replace_with_a_very_long_secure_random_string_for_access_token_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_very_long_secure_random_string_for_refresh_token_32chars
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 4. INITIAL ADMIN BOOTSTRAP (Digunakan sekali saat pertama instalasi: npm run seed:admin)
# ------------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@bantuin.id
ADMIN_INITIAL_PHONE=+628110000001
ADMIN_INITIAL_PASSWORD=ChangeMeWithVeryStrongPassword123!

# ------------------------------------------------------------------------------
# 5. PENYIMPANAN DOKUMEN & FOTO (STORAGE)
# Database hanya menyimpan metadata/path. File asli disimpan di object storage privat.
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
# Masa berlaku signed URL untuk akses berkas privat (dalam menit)
STORAGE_SIGNED_URL_EXPIRY_MINUTES=30

# ------------------------------------------------------------------------------
# 6. INTEGRASI PAYMENT GATEWAY (Midtrans / Xendit Sandbox)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=midtrans
PAYMENT_SERVER_KEY=your_sandbox_server_key_here
PAYMENT_CLIENT_KEY=your_sandbox_client_key_here
PAYMENT_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 7. AI PROVIDER MANAGEMENT (Google Gemini, Groq AI & Provider Kustom)
# ------------------------------------------------------------------------------
ACTIVE_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_ENDPOINT=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 8. INTEGRASI WHATSAPP GATEWAY (Fonnte API)
# ------------------------------------------------------------------------------
FONNTE_API_TOKEN=RfGCUd3MgLq3i4RsfGZX
FONNTE_API_URL=https://api.fonnte.com/send